generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ResourceCategory {
  shelter
  food
  hygiene
  transportation
  healthcare
  mental_health
  employment
  legal_documentation
}

enum MessageRole {
  user
  assistant
}

model Session {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isCrisis    Boolean  @default(false)
  needsJson   String   @default("[]")
  messages    Message[]
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())
  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Resource {
  id        String           @id @default(cuid())
  name      String
  category  ResourceCategory
  address   String
  phone     String
  hours     String
  notes     String
  createdAt DateTime         @default(now())

  @@index([category])
}
